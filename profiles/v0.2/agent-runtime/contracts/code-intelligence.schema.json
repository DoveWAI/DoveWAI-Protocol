{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dovewai.org/protocol/v0.2/profiles/agent-runtime/contracts/code-intelligence.schema.json",
  "title": "DoveWAI Code Intelligence Record",
  "type": "object",
  "required": ["version", "repo_id", "revision", "observed_at"],
  "properties": {
    "version": {"const": "0.1"},
    "repo_id": {"type": "string", "minLength": 1},
    "revision": {"type": "string", "minLength": 1},
    "observed_at": {"type": "string", "format": "date-time"},
    "languages": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "symbols": {"type": "array", "items": {"type": "object", "additionalProperties": true}},
    "imports": {"type": "array", "items": {"type": "object", "additionalProperties": true}},
    "calls": {"type": "array", "items": {"type": "object", "additionalProperties": true}},
    "data_flows": {"type": "array", "items": {"type": "object", "additionalProperties": true}},
    "dependencies": {"type": "array", "items": {"type": "object", "additionalProperties": true}},
    "security_findings": {"type": "array", "items": {"type": "object", "additionalProperties": true}},
    "change_impact": {"type": "array", "items": {"type": "object", "additionalProperties": true}},
    "storage": {"type": "object", "additionalProperties": true},
    "provenance": {"type": "array", "items": {"type": "object", "additionalProperties": true}}
  },
  "additionalProperties": false
}
