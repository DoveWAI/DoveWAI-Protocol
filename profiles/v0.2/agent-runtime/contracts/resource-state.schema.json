{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dovewai.org/protocol/v0.2/profiles/agent-runtime/contracts/resource-state.schema.json",
  "title": "DoveWAI Resource State",
  "type": "object",
  "required": ["version", "resource_id", "kind", "observed_at", "status"],
  "properties": {
    "version": {"const": "0.1"},
    "resource_id": {"type": "string", "minLength": 1},
    "kind": {"enum": ["model_quota", "api", "cpu", "gpu", "npu", "ram", "vram", "storage", "nas", "network", "cloud_credit", "provider", "device"]},
    "provider": {"type": "string"},
    "observed_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "status": {"enum": ["available", "degraded", "exhausted", "offline", "unknown"]},
    "capacity": {"type": ["number", "integer"]},
    "available": {"type": ["number", "integer"]},
    "unit": {"type": "string"},
    "reset_at": {"type": "string", "format": "date-time"},
    "runway_seconds": {"type": "number", "minimum": 0},
    "cost": {"type": "object", "additionalProperties": true},
    "privacy": {"type": "object", "additionalProperties": true},
    "capabilities": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "evidence": {"type": "array", "items": {"type": "object", "additionalProperties": true}}
  },
  "additionalProperties": false
}
