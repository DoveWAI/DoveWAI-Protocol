{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dovewai.org/protocol/profiles/v0.2/agent-runtime/contracts/worker-allocation.schema.json",
  "title": "DoveWAI Agent Runtime Worker Allocation",
  "type": "object",
  "required": ["worker_id", "workspace_id", "task_id", "isolation"],
  "properties": {
    "worker_id": { "type": "string", "minLength": 1 },
    "workspace_id": { "type": "string", "minLength": 1 },
    "task_id": { "type": "string", "minLength": 1 },
    "isolation": {
      "type": "object",
      "required": ["git", "browser", "credentials"],
      "properties": {
        "git": { "enum": ["worktree", "clone", "container", "none"] },
        "browser": { "enum": ["space", "profile", "context", "none"] },
        "credentials": { "enum": ["task_scoped", "worker_scoped", "none"] },
        "process": { "enum": ["host", "container", "vm", "sandbox", "other"] }
      },
      "additionalProperties": false
    },
    "git_worktree": { "type": "string" },
    "branch": { "type": "string" },
    "browser_space": { "type": "string" },
    "browser_profile": { "type": "string" },
    "resource_budget_id": { "type": "string" },
    "authorization_ref": { "type": "string" },
    "receipt_namespace": { "type": "string" },
    "expires_at": { "type": "string", "format": "date-time" },
    "cleanup_required": { "type": "boolean", "default": true },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "additionalProperties": false
}
