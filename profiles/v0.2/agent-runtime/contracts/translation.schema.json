{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dovewai.org/protocol/v0.2/profiles/agent-runtime/contracts/translation.schema.json",
  "title": "DoveWAI Translation Record",
  "type": "object",
  "required": ["version", "translation_id", "source_language", "target_language", "source_text", "translated_text"],
  "properties": {
    "version": {"const": "0.1"},
    "translation_id": {"type": "string", "minLength": 1},
    "source_language": {"type": "string", "minLength": 1},
    "target_language": {"type": "string", "minLength": 1},
    "source_text": {"type": "string"},
    "translated_text": {"type": "string"},
    "locale": {"type": "string"},
    "currency": {"type": "string"},
    "preserve_source": {"type": "boolean", "default": true},
    "engine": {"type": "string"},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "provenance": {"type": "array", "items": {"type": "object", "additionalProperties": true}}
  },
  "additionalProperties": false
}
