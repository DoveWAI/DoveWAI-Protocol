{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dovewai.org/protocol/v0.2/core.schema.json",
  "title": "DoveWAI Protocol v0.2 Core",
  "$defs": {
    "extensions": {"type":"object","propertyNames":{"pattern":"^[A-Za-z0-9]+(?:[._-][A-Za-z0-9]+)+$"},"additionalProperties":true},
    "base": {"type":"object","required":["protocol_version","id","type","created_at"],"properties":{"protocol_version":{"const":"0.2"},"id":{"type":"string","minLength":1,"maxLength":256},"type":{"type":"string","minLength":1},"created_at":{"type":"string","format":"date-time"},"extensions":{"$ref":"#/$defs/extensions"}}},
    "digest": {"type":"object","required":["algorithm","value"],"properties":{"algorithm":{"enum":["sha256","sha384","sha512"]},"value":{"type":"string","minLength":1}},"additionalProperties":false},
    "provenance": {"allOf":[{"$ref":"#/$defs/base"},{"properties":{"type":{"const":"Provenance"},"source":{"type":"string"},"uri":{"type":"string"},"acquired_at":{"type":"string","format":"date-time"},"digest":{"$ref":"#/$defs/digest"},"media_type":{"type":"string"},"transformation":{"type":"string"}}}],"unevaluatedProperties":false},
    "task": {"allOf":[{"$ref":"#/$defs/base"},{"required":["intent"],"properties":{"type":{"const":"Task"},"intent":{"type":"string","minLength":1},"inputs":{},"required_capabilities":{"type":"array","items":{"type":"string"},"uniqueItems":true},"constraints":{"type":"object","additionalProperties":true},"deadline":{"type":"string","format":"date-time"},"correlation_id":{"type":"string"},"parent_task_id":{"type":"string"},"idempotency_key":{"type":"string","minLength":1},"provenance":{"type":"array","items":{"$ref":"#/$defs/provenance"}}}}],"unevaluatedProperties":false},
    "capability": {"allOf":[{"$ref":"#/$defs/base"},{"required":["name","version"],"properties":{"type":{"const":"Capability"},"name":{"type":"string","minLength":1},"version":{"type":"string","minLength":1},"features":{"type":"array","items":{"type":"string"},"uniqueItems":true},"input_schema":{"type":"object"},"output_schema":{"type":"object"},"limits":{"type":"object","additionalProperties":true}}}],"unevaluatedProperties":false},
    "claim": {"allOf":[{"$ref":"#/$defs/base"},{"required":["task_id","holder_id","mode","lease_expires_at"],"properties":{"type":{"const":"Claim"},"task_id":{"type":"string","minLength":1},"holder_id":{"type":"string","minLength":1},"mode":{"enum":["read","write"]},"lease_expires_at":{"type":"string","format":"date-time"},"lease_generation":{"type":"integer","minimum":0},"fencing_token":{"type":["string","integer"]},"renewed_at":{"type":"string","format":"date-time"},"revoked_at":{"type":"string","format":"date-time"},"supersedes_claim_id":{"type":"string"},"scope":{"type":"object","additionalProperties":true}}}],"unevaluatedProperties":false},
    "attempt": {"allOf":[{"$ref":"#/$defs/base"},{"required":["task_id","attempt_number","status"],"properties":{"type":{"const":"Attempt"},"task_id":{"type":"string","minLength":1},"claim_id":{"type":"string"},"executor_id":{"type":"string"},"attempt_number":{"type":"integer","minimum":1},"status":{"enum":["pending","running","succeeded","failed","cancelled"]},"started_at":{"type":"string","format":"date-time"},"ended_at":{"type":"string","format":"date-time"},"resume_from":{"type":"string"}}}],"unevaluatedProperties":false},
    "executionEvent": {"allOf":[{"$ref":"#/$defs/base"},{"required":["task_id","event_type"],"properties":{"type":{"const":"ExecutionEvent"},"task_id":{"type":"string","minLength":1},"attempt_id":{"type":"string"},"event_type":{"type":"string","minLength":1},"sequence":{"type":"integer","minimum":0},"occurred_at":{"type":"string","format":"date-time"},"observed_at":{"type":"string","format":"date-time"},"correlation_id":{"type":"string"},"causation_id":{"type":"string"},"previous_event_id":{"type":"string"},"data":{}}}],"unevaluatedProperties":false},
    "artifact": {"allOf":[{"$ref":"#/$defs/base"},{"required":["uri"],"properties":{"type":{"const":"Artifact"},"task_id":{"type":"string"},"attempt_id":{"type":"string"},"uri":{"type":"string","minLength":1},"media_type":{"type":"string"},"size":{"type":"integer","minimum":0},"digest":{"$ref":"#/$defs/digest"},"producer_id":{"type":"string"},"source_artifact_ids":{"type":"array","items":{"type":"string"},"uniqueItems":true},"metadata":{"type":"object","additionalProperties":true}}}],"unevaluatedProperties":false},
    "result": {"allOf":[{"$ref":"#/$defs/base"},{"required":["task_id","status"],"properties":{"type":{"const":"Result"},"task_id":{"type":"string","minLength":1},"attempt_id":{"type":"string"},"status":{"enum":["succeeded","failed","cancelled"]},"outputs":{},"artifact_ids":{"type":"array","items":{"type":"string"},"uniqueItems":true},"metrics":{"type":"object","additionalProperties":true},"evidence":{"type":"array","items":{}},"provenance":{"type":"array","items":{"$ref":"#/$defs/provenance"}},"warnings":{"type":"array","items":{"type":"string"}}}}],"unevaluatedProperties":false},
    "verification": {"allOf":[{"$ref":"#/$defs/base"},{"required":["subject","verifier_id","method","outcome"],"properties":{"type":{"const":"Verification"},"subject":{"type":"object","required":["type","id"],"properties":{"type":{"type":"string"},"id":{"type":"string"}},"additionalProperties":false},"verifier_id":{"type":"string","minLength":1},"method":{"type":"string","minLength":1},"outcome":{"enum":["passed","failed","indeterminate","skipped"]},"policy":{"type":"string"},"observations":{},"evidence":{"type":"array","items":{}},"artifact_ids":{"type":"array","items":{"type":"string"},"uniqueItems":true},"policy_decision_ref":{"type":"string"}}}],"unevaluatedProperties":false},
    "workReceipt": {"allOf":[{"$ref":"#/$defs/base"},{"required":["task_id","result_id","status"],"properties":{"type":{"const":"WorkReceipt"},"task_id":{"type":"string","minLength":1},"result_id":{"type":"string","minLength":1},"claim_id":{"type":"string"},"attempt_ids":{"type":"array","items":{"type":"string"},"uniqueItems":true},"artifact_ids":{"type":"array","items":{"type":"string"},"uniqueItems":true},"verification_ids":{"type":"array","items":{"type":"string"},"uniqueItems":true},"evidence":{"type":"array","items":{}},"status":{"enum":["recorded","verified","verification_failed","indeterminate"]},"issued_by":{"type":"string"},"started_at":{"type":"string","format":"date-time"},"completed_at":{"type":"string","format":"date-time"},"digest":{"$ref":"#/$defs/digest"},"signature_ref":{"type":"string"}}}],"unevaluatedProperties":false},
    "protocolError": {"allOf":[{"$ref":"#/$defs/base"},{"required":["code","message"],"properties":{"type":{"const":"ProtocolError"},"code":{"type":"string","minLength":1},"message":{"type":"string","minLength":1},"details":{},"retryable":{"type":"boolean"}}}],"unevaluatedProperties":false}
  },
  "oneOf": [
    {"$ref":"#/$defs/task"},{"$ref":"#/$defs/capability"},{"$ref":"#/$defs/claim"},{"$ref":"#/$defs/attempt"},{"$ref":"#/$defs/executionEvent"},{"$ref":"#/$defs/artifact"},{"$ref":"#/$defs/result"},{"$ref":"#/$defs/verification"},{"$ref":"#/$defs/workReceipt"},{"$ref":"#/$defs/provenance"},{"$ref":"#/$defs/protocolError"}
  ]
}
